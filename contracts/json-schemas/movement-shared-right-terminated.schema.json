{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sigpe.local/json-schemas/movement-shared-right-terminated.v1.schema.json",
  "title": "movement.shared_right.terminated — data (v1)",
  "type": "object",
  "required": [
    "shared_right_id",
    "asset_id",
    "responsible_institution_id",
    "beneficiary_institution_id",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "shared_right_id": {
      "type": "string",
      "format": "uuid"
    },
    "asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "responsible_institution_id": {
      "type": "string",
      "format": "uuid"
    },
    "beneficiary_institution_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "suspended",
        "terminated"
      ]
    },
    "motif": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
