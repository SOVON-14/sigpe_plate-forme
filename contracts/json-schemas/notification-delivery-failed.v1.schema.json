{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigpe.local/schemas/notification-delivery-failed.v1.schema.json",
  "title": "notification.delivery_failed.v1 — payload data",
  "type": "object",
  "required": ["delivery_id", "notification_id", "channel", "attempts", "failed_at"],
  "properties": {
    "delivery_id": { "type": "string", "format": "uuid" },
    "notification_id": { "type": "string", "format": "uuid" },
    "recipient_account_id": { "type": "string", "format": "uuid" },
    "channel": { "type": "string", "enum": ["in_app", "email", "sms"] },
    "attempts": { "type": "integer", "minimum": 1 },
    "last_error": { "type": ["string", "null"] },
    "failed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
