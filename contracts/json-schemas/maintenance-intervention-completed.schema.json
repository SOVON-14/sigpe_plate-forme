{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sigpe.local/json-schemas/maintenance-intervention-completed.schema.json",
  "title": "maintenance.intervention.completed — data (v1)",
  "type": "object",
