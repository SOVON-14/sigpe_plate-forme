    },
    "reference": {
      "type": "string"
    },
    "institution_id": {
      "type": "string",
      "format": "uuid"
    },
    "asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "type": {
      "type": "string"
    },
    "provider_kind": {
      "type": "string"
    },
    "supplier_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "costs": {
