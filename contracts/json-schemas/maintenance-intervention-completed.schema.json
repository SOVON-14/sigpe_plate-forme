          "type": "number"
        },
        "parts": {
          "type": "number"
        },
        "supplies": {
          "type": "number"
        },
        "transport": {
          "type": "number"
        },
        "external_services": {
          "type": "number"
        },
        "other": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
