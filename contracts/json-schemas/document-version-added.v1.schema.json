{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigpe.local/schemas/document-version-added.v1.schema.json",
  "title": "document.version_added.v1 — payload data",
  "type": "object",
  "required": ["document_id", "version_id", "version_number", "sha256", "size_bytes", "created_at"],
  "properties": {
    "document_id": { "type": "string", "format": "uuid" },
    "version_id": { "type": "string", "format": "uuid" },
    "version_number": { "type": "integer", "minimum": 1 },
    "original_filename": { "type": "string" },
    "mime_type": { "type": "string" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previous_version_id": { "type": ["string", "null"], "format": "uuid" },
    "uploaded_by": { "type": ["string", "null"], "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
