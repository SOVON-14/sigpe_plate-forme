{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sigpe.local/json-schemas/movement-internal-transfer-completed.v1.schema.json",
  "title": "movement.internal_transfer.completed — data (v1)",
  "type": "object",
