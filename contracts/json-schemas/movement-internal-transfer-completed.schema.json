  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "institution_id": {
      "type": "string",
      "format": "uuid"
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "origin_unit_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "destination_unit_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
