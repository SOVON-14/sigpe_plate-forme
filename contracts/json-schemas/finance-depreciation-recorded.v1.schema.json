{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigpe.local/schemas/finance-depreciation-recorded.v1.schema.json",
  "title": "finance.depreciation_recorded.v1",
  "type": "object",
  "required": ["entry_id", "asset_id", "period_start", "period_end", "amount", "method", "recorded_at"],
  "properties": {
    "entry_id": { "type": "string", "format": "uuid" },
    "asset_id": { "type": "string", "format": "uuid" },
    "institution_id": { "type": ["string", "null"], "format": "uuid" },
    "period_start": { "type": "string", "format": "date" },
    "period_end": { "type": "string", "format": "date" },
    "amount": { "type": "number", "minimum": 0 },
    "method": { "type": "string" },
    "accumulated_depreciation": { "type": "number", "minimum": 0 },
    "net_book_value": { "type": ["number", "null"], "minimum": 0 },
    "recorded_by": { "type": "string", "format": "uuid" },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
