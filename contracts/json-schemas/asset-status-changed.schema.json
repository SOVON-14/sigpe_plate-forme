{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sigpe.local/json-schemas/asset-status-changed.v1.schema.json",
  "title": "asset.status.changed — data (v1)",
  "type": "object",
  "required": [
    "asset_id",
    "institution_id",
    "status",
    "previous_status"
  ],
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "institution_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "actif",
        "provisoire",
        "en_reforme",
        "sorti"
      ]
    },
    "previous_status": {
      "type": "string",
      "enum": [
        "actif",
        "provisoire",
        "en_reforme",
        "sorti"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
